#!/usr/bin/env bash
set -euo pipefail

# dot-agents — install and inspect ~/.agents from this repository.
# See .agents/standards/install.md

VERSION="0.1.0"

resolve_source() {
  if [[ -n "${DOT_AGENTS_SOURCE:-}" ]]; then
    echo "$DOT_AGENTS_SOURCE"
    return
  fi
  local root
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  echo "${root}/.agents"
}

resolve_home() {
  echo "${DOT_AGENTS_HOME:-$HOME/.agents}"
}

cmd_install() {
  local src dest
  src="$(resolve_source)"
  dest="$(resolve_home)"
  if [[ ! -d "$src" ]]; then
    echo "error: source not found: $src" >&2
    exit 1
  fi
  mkdir -p "$dest"
  rsync -a --exclude='STRUCTURE.md' "$src/" "$dest/"
  echo "Installed from $src"
  echo "Target: $dest"
  echo "Run: dot-agents status"
}

cmd_status() {
  local dest
  dest="$(resolve_home)"
  if [[ ! -d "$dest" ]]; then
    echo "Not installed: $dest"
    exit 1
  fi
  local count
  count="$(find "$dest" -type f | wc -l | tr -d ' ')"
  echo "dot-agents $VERSION"
  echo "Home: $dest"
  echo "Files: $count"
  if [[ -f "$dest/AGENTS.md" ]]; then
    echo "Entry: $dest/AGENTS.md"
  fi
}

cmd_doctor() {
  local dest src
  dest="$(resolve_home)"
  src="$(resolve_source)"
  local ok=0
  for f in AGENTS.md standards/README.md context/writing-standard.md; do
    if [[ -f "$dest/$f" ]]; then
      echo "ok  $f"
    else
      echo "missing  $f (run: dot-agents install)"
      ok=1
    fi
  done
  if [[ ! -d "$src" ]]; then
    echo "warn  source .agents not found at $src (set DOT_AGENTS_SOURCE)"
  fi
  exit "$ok"
}

usage() {
  cat <<EOF
dot-agents $VERSION — global ~/.agents installer

Usage:
  dot-agents install   Copy repo .agents/ to DOT_AGENTS_HOME (default ~/.agents)
  dot-agents status    Show install location and file count
  dot-agents doctor    Check required foundation files

Environment:
  DOT_AGENTS_HOME    Install target (default: ~/.agents)
  DOT_AGENTS_SOURCE  Source .agents directory (default: repo .agents/)

Docs: .agents/standards/install.md
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    install) cmd_install ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage >&2; exit 1 ;;
  esac
}

main "$@"
